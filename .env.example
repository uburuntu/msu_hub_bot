# Use uv run --env-file .env msu-hub-bot. Never commit .env.
# Required: HUB_BOT_TOKEN, HUB_REDIS_HOST, HUB_EDGEDB_DSN.
HUB_NAME=hub
HUB_BOT_TOKEN=
HUB_REDIS_HOST=
HUB_REDIS_PORT=6379
HUB_REDIS_PASSWORD=
HUB_REDIS_DB=0
HUB_EDGEDB_DSN=
HUB_EDGEDB_TLS_CA=
HUB_EDGEDB_TLS_SECURITY=strict
HUB_PROXY=
HUB_CERT=
HUB_PKEY=
HUB_LOGS_FILE=.local/logs/{name}.log
HUB_HEALTH_CHECK_URL=
# Optional telemetry uses a project write token, never management/read credentials.
HUB_TELEMETRY_ENABLED=false
HUB_TELEMETRY_SAMPLE_RATE=0.1
HUB_ENVIRONMENT=local
HUB_RELEASE=
LOGFIRE_TOKEN=
HUB_DUMPS_CHAT_ID=0
HUB_EVENTS_CHAT_ID=0
HUB_ERROR_CHAT_ID=0
HUB_OWNER_ID=0
HUB_FOUNDER_IDS='[]'
HUB_FORWARD_CHAT_IDS='[0, 0]'
HUB_RELATED_CHAT_IDS='[0, 0]'
HUB_POOKIE_CHAT_ID=0
HUB_ECHO_CHAT_ID=0
HUB_EXCLUDED_CHAT_ID=0
HUB_DVACH_CHAT_IDS='[0, 0, 0, 0, 0]'
HUB_ANTIBOT_USER_ID=0
HUB_POSTING_TB_CHAT_ID=0
HUB_POSTING_MAIN_CHAT_ID=0
HUB_VK_DEFAULT_CHAT_ID=0
HUB_TENET_STICKER_OWNER_ID=0
HUB_VK_USER_TOKEN=
HUB_WOLFRAM_TOKEN=
HUB_WIT_TOKENS='[]'
HUB_JDOODLE_TOKENS='[]'
HUB_LINGVANEX_AUTHORIZATION=
HUB_LINGVANEX_IMAGE_AUTHORIZATION=
HUB_REMOVE_BG_API_KEY=
HUB_IMGUR_AUTHORIZATION=
HUB_OWM_KEY=
HUB_OWM_MAP_KEY=
HUB_MAPBOX_KEY=
HUB_ACRCLOUD_HOST=
HUB_ACRCLOUD_ACCESS_KEY=
HUB_ACRCLOUD_ACCESS_SECRET=
HUB_SUPPORTERS_BASE=
HUB_SUPPORTERS_TABLE=
HUB_SUPPORTERS_API_KEY=
